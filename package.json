    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@xmldom/xmldom": "0.9.12",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
