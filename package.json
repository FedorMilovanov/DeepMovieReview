    "audit:styles": "node scripts/style-contract.mjs",
    "audit:style-parity": "node scripts/style-fingerprint.mjs",
    "audit:film001": "node scripts/film001-audit.mjs",
    "audit:homepage": "node scripts/homepage-audit.mjs",
    "audit:premium": "node scripts/premium-audit.mjs",
    "audit:reading": "node scripts/reading-quality-audit.mjs",
    "test:a11y": "node scripts/accessibility-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
